# Image-derivative manifests + generated size folders. See
# docs/03_CONVENTIONS.md "Image Asset Derivatives" for the pattern:
# each family stores one master size in source control; all other sizes
# are regenerated locally at startup by game.assets.image_derivatives.

# Components: master is 1024/; all others are derivatives.
assets/images/components/2048/*
assets/images/components/512/*
assets/images/components/256/*
assets/images/components/128/*
assets/images/components/64/*

# Flags: master is flag_*/1024/; all others are derivatives.
assets/images/flags/Processed/.flag_derivatives_manifest.json
assets/images/flags/Processed/flag_*/512/*
assets/images/flags/Processed/flag_*/256/*
assets/images/flags/Processed/flag_*/128/*
assets/images/flags/Processed/flag_*/64/*
assets/images/flags/Processed/flag_*/32/*

# Stars: master is 1024/; all others are derivatives.
assets/images/stellar_objects/Stars/.star_derivatives_manifest.json
assets/images/stellar_objects/Stars/512/*
assets/images/stellar_objects/Stars/256/*
assets/images/stellar_objects/Stars/128/*

# Planets: master is 2048/; all others are derivatives.
assets/images/stellar_objects/Planets/.planet_derivatives_manifest.json
assets/images/stellar_objects/Planets/1024/*
assets/images/stellar_objects/Planets/512/*
assets/images/stellar_objects/Planets/256/*
assets/images/stellar_objects/Planets/128/*

# Legacy pre-rename size-folder names. The asset rename pass moved
# tracked content from "Components <N>/", "Stars/Stars_<N>/", and
# "Planets/Planets_V3/Planets_V3_<N>/" into bare numeric folder names
# (1024/, 64/, etc.). Untracked derivative files that pre-dated the
# rename can linger at the old paths on machines that ran the
# derivative engine before pulling these commits; these patterns keep
# them out of `git status` until they're manually deleted. Safe to
# remove the old-named folders from disk at any time — the engine
# regenerates everything under the new (numeric-only) paths.
assets/images/components/Components 64/
assets/images/components/Components 128/
assets/images/components/Components 256/
assets/images/components/Components 512/
assets/images/components/Components 1024/
assets/images/components/Components 2048/
assets/images/stellar_objects/Stars/Stars_128/
assets/images/stellar_objects/Stars/Stars_256/
assets/images/stellar_objects/Stars/Stars_512/
assets/images/stellar_objects/Stars/Stars_1024/
assets/images/stellar_objects/Planets/Planets_V3/

# PROJ-314: ship-portrait regeneration manifest (per-run, ephemeral).
Tools/regenerate_ship_portraits/last_run.json
AgentCoordination/generated/skill_usage/summary.json

