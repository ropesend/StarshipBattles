{
  "effortLevel": "high",
  "env": {
    "PATH": "C:\\Program Files\\GitHub CLI;${PATH}"
  },
  "permissions": {
    "allow": [
      "Bash(cd:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import subprocess,json; r=subprocess.run(['python','Tools/check_context/check_context.py'],capture_output=True,text=True); print(json.dumps({'systemMessage':(r.stdout+r.stderr).rstrip()}))\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python Tools/agent_coordination/claude_skill_usage_hook.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python Tools/agent_coordination/claude_skill_usage_hook.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
