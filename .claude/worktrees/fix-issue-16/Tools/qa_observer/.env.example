# Absolute path to where the Windows Snipping Tool saves images by default.
# Make sure this has double backslashes or forward slashes in Windows.
SCREENSHOTS_DIR='C:\Users\rossr\Pictures\Screenshots'

# Auto-created session output folder path
SESSION_OUTPUT_DIR='./session_data'

# Google Cloud Auth
# GOOGLE_APPLICATION_CREDENTIALS='C:\path\to\your\service-account-file.json'

# Audio Recording Settings (Voice Activity Detection)
VOICE_THRESHOLD=300
SILENCE_TIMEOUT=2.0

# Filler words to remove from the markdown transcript (comma-separated, case-insensitive)
FILLER_WORDS=ah,um,uh,uh-huh,hmm,er,hm,mm,mmm,mhm
