    },
    {
      "file": "tests/data/ships/Test_Engine_3x_HighMass.json",
      "position": [
        0,
        100
      ],
      "movement_policy": "test_straight_line",
      "targeting_policy": "standard"
    }
  ],
  "duration_ticks": 1000,
