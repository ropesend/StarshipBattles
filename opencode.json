{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-pro",
  "shell": "pwsh",
  "instructions": ["./AGENTS.md"],
  "autoupdate": true,
  "snapshot": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "provider": {
    "deepseek": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    }
  },
  "agent": {
    "plan": {
  "command": {
    "audit-shrink": {
      "template": "Load the audit-shrink skill and run a comprehensive code shrinkage audit on the production codebase (game/).",
      "description": "Run a comprehensive code shrinkage audit"
    }
  },
  "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  },
  "permission": {
    "skill": {
      "*": "allow",
      "proj-*": "deny",
      "ticket-*": "deny",
      "codex-*": "deny",
      "analysis-*": "deny",
      "debug-*": "deny",
      "deep-dive-*": "deny",
      "qa-*": "deny",
      "fix-crash": "deny",
      "loc": "deny",
      "triage-to-proj": "deny",
      "validate-designs": "deny"
    }
  }
}
