{
    "modifiers": [
        {
            "id": "hardened_mount",
            "name": "Hardened",
            "description": "HP increases as the square of mass multiplier. 2x mass = 4x HP.",
            "param": {
                "name": "Mass Mult",
                "type": "linear",
                "min": 1.0,
                "max": 10.0,
                "default": 1.0
            },
            "effects": [
                {
                    "stat": "mass_mult",
                    "formula": "param"
                },
                {
                    "stat": "hp_mult",
                    "formula": "param ^ 2"
                },
                {
                    "stat": "cost_mult",
                    "formula": "param"
                }
            ],
            "restrictions": {
                "deny_abilities": [
                    "Armor"
                ]
            }
        },
        {
            "id": "turret_mount",
            "name": "Turret Mount",
            "description": "Adds firing arc. Mass scales with arc (diminishing returns).",
            "param": {
                "name": "arc",
                "type": "linear",
                "min": 0,
                "max": 180,
                "default": 45
            },
            "effects": [
                {
                    "stat": "mass_mult",
                    "formula": "1.0 + 0.514 * ln(1.0 + param / 30.0)"
                },
                {
                    "stat": "arc_set",
                    "formula": "param",
                    "operation": "set"
                }
            ],
            "restrictions": {
                "allow_abilities": [
                    "Weapon",
                    "ProjectileWeaponAbility",
                    "BeamWeaponAbility",
                    "SeekerWeaponAbility"
                ]
            }
        },
        {
            "id": "simple_size_mount",
            "name": "Size Mount",
            "description": "Multiplies Size/Stats (0.1x-1024x)",
            "param": {
                "name": "Scale",
                "type": "linear",
                "min": 0.1,
                "max": 1024,
                "default": 1
            },
            "effects": [
                {
                    "stat": "mass_mult",
                    "formula": "param"
                },
                {
                    "stat": "hp_mult",
                    "formula": "param"
                },
                {
                    "stat": "damage_mult",
                    "formula": "param"
                },
                {
                    "stat": "cost_mult",
                    "formula": "param ^ 0.75"
                },
                {
                    "stat": "thrust_mult",
                    "formula": "param"
                },
                {
                    "stat": "turn_mult",
                    "formula": "param"
                },
                {
                    "stat": "strategic_mult",
                    "formula": "param"
                },
                {
                    "stat": "energy_gen_mult",
                    "formula": "param"
                },
                {
                    "stat": "capacity_mult",
                    "formula": "param"
                },
                {
                    "stat": "crew_capacity_mult",
                    "formula": "param"
                },
                {
                    "stat": "life_support_capacity_mult",
                    "formula": "param"
                },
                {
                    "stat": "consumption_mult",
                    "formula": "param"
                },
                {
                    "stat": "crew_req_mult",
                    "formula": "param"
                },
                {
                    "stat": "harvest_rate_mult",
                    "formula": "param"
                },
                {
                    "stat": "local_storage_mult",
                    "formula": "param"
                },
                {
                    "stat": "production_rate_mult",
                    "formula": "param"
                },
                {
                    "stat": "planetary_yard_rate_mult",
                    "formula": "param"
                },
                {
                    "stat": "launch_rate_mult",
                    "formula": "param"
                },
                {
                    "stat": "recovery_rate_mult",
                    "formula": "param"
                },
                {
                    "stat": "bay_capacity_mult",
                    "formula": "param"
                }
            ]
        },
        {
            "id": "range_mount",
            "name": "Range Mount",
            "description": "Each level doubles range. Mass/HP/Cost increase 3.5x per doubling.",
            "param": {
                "name": "Level",
                "type": "linear",
                "min": 0,
                "max": 10,
                "default": 0
            },
            "effects": [
                {
                    "stat": "range_mult",
                    "formula": "2 ^ param"
                },
                {
                    "stat": "mass_mult",
                    "formula": "3.5 ^ param"
                },
                {
                    "stat": "hp_mult",
                    "formula": "3.5 ^ param"
                },
                {
                    "stat": "cost_mult",
                    "formula": "3.5 ^ param"
                }
            ],
            "restrictions": {
                "allow_abilities": [
                    "ProjectileWeaponAbility",
                    "BeamWeaponAbility"
                ],
                "deny_abilities": [
                    "SeekerWeaponAbility"
                ]
            }
        },
        {
            "id": "facing",
            "name": "Facing Angle",
            "description": "Sets the firing direction (0=Forward).",
            "param": {
                "name": "Angle",
                "type": "linear",
                "min": 0,
                "max": 359,
                "default": 0
            },
            "effects": [
                {
                    "stat": "facing_angle",
                    "formula": "param",
                    "operation": "set"
                }
            ],
            "restrictions": {
                "allow_abilities": [
                    "ProjectileWeaponAbility",
                    "BeamWeaponAbility",
                    "SeekerWeaponAbility"
                ]
            }
        },
        {
            "id": "precision_mount",
            "name": "Precision Targeting",
            "description": "Increases Base Accuracy Score by +0.5 per level. Mass increases significantly.",
            "param": {
                "name": "Level",
                "type": "linear",
                "min": 0,
                "max": 5,
                "default": 0
            },
            "effects": [
                {
                    "stat": "accuracy_add",
                    "formula": "param * 0.5",
                    "operation": "add"
                },
                {
                    "stat": "mass_mult",
                    "formula": "1.0 + param * 0.5"
                },
                {
                    "stat": "cost_mult",
                    "formula": "1.5 ^ param"
                }
            ],
            "restrictions": {
                "allow_abilities": [
                    "BeamWeaponAbility"
                ]
            }
        },
        {
            "id": "rapid_fire",
            "name": "Rapid Fire Mount",
            "description": "Reduces reload time by increasing fire rate. Mass increases with rate multiplier. Applies to all weapons.",
            "param": {
                "name": "Fire Rate Multiplier",
                "type": "linear",
                "min": 1.0,
                "max": 10.0,
                "default": 1.0
            },
            "effects": [
                {
                    "stat": "reload_mult",
                    "formula": "1.0 / param"
                },
                {
                    "stat": "mass_mult",
                    "formula": "(param - 1.0) * 2.0",
                    "operation": "add_to_mult"
                },
                {
                    "stat": "cost_mult",
                    "formula": "sqrt(param)"
                }
            ],
            "restrictions": {
                "allow_abilities": [
                    "Weapon",
                    "ProjectileWeaponAbility",
                    "BeamWeaponAbility",
                    "SeekerWeaponAbility"
                ]
            }
        },
        {
            "id": "seeker_endurance",
            "name": "Endurance Mount",
            "description": "Increases seeker endurance/range (1x-10x). Mass scales with endurance.",
            "param": {
                "name": "Multiplier",
                "type": "linear",
                "min": 1.0,
                "max": 10.0,
                "default": 1.0
            },
            "effects": [
                {
                    "stat": "endurance_mult",
                    "formula": "param"
                },
                {
                    "stat": "mass_mult",
                    "formula": "1.0 + (param - 1.0) * 0.5"
                },
                {
                    "stat": "cost_mult",
                    "formula": "param"
                }
            ],
            "restrictions": {
                "allow_abilities": [
                    "SeekerWeaponAbility"
                ]
            }
        },
        {
            "id": "seeker_damage",
