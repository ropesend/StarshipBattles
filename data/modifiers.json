                "max": 1000.0,
                "default": 1.0
            },
            "effects": [
                {
                    "stat": "projectile_damage_mult",
                    "formula": "param"
                },
                {
                    "stat": "mass_mult",
                    "formula": "1.0 + (param - 1.0) * 0.75"
                },
                {
                    "stat": "cost_mult",
                    "formula": "sqrt(param)"
                }
            ],
            "restrictions": {
                "allow_abilities": [
                    "SeekerWeaponAbility"
                ]
            }
        },
        {
            "id": "seeker_armored",
            "name": "Armored Missile Mount",
            "description": "Increases seeker HP (1x-1000x). Mass scales with HP.",
            "param": {
                "name": "Multiplier",
                "type": "linear",
                "min": 1.0,
                "max": 1000.0,
                "default": 1.0
            },
            "effects": [
                {
                    "stat": "projectile_hp_mult",
                    "formula": "param"
                },
                {
                    "stat": "mass_mult",
                    "formula": "1.0 + (param - 1.0) * 0.75"
                },
                {
                    "stat": "cost_mult",
                    "formula": "sqrt(param)"
                }
            ],
            "restrictions": {
                "allow_abilities": [
                    "SeekerWeaponAbility"
                ]
            }
        },
        {
            "id": "seeker_stealth",
            "name": "Stealth Mount",
            "description": "Makes seeker harder to hit. Mass rises dramatically with stealth level.",
            "param": {
                "name": "Level",
                "type": "linear",
                "min": 0,
                "max": 10,
                "default": 0
            },
            "effects": [
                {
                    "stat": "projectile_stealth_add",
                    "formula": "param",
                    "operation": "add"
                },
                {
                    "stat": "mass_mult",
                    "formula": "1.0 + param * 2.0"
                },
                {
                    "stat": "cost_mult",
                    "formula": "2.0 ^ param"
                }
            ],
            "restrictions": {
                "allow_abilities": [
                    "SeekerWeaponAbility"
                ]
            }
        },
        {
            "id": "automation",
            "name": "Automation",
            "description": "Reduces crew requirement (0% to 99%). Mass increases with automation.",
            "param": {
                "name": "Reduction",
                "type": "linear",
                "min": 0.0,
                "max": 0.99,
                "default": 0.0
            },
            "effects": [
                {
                    "stat": "crew_req_mult",
                    "formula": "1.0 - param"
                },
                {
                    "stat": "mass_mult",
                    "formula": "1.0 + param"
                },
                {
                    "stat": "cost_mult",
                    "formula": "1.0 + param"
                }
            ],
            "restrictions": {
                "allow_abilities": [
                    "RequiresMaintenance"
                ]
            }
        },
        {
            "id": "efficiency_mount",
            "name": "Efficiency",
            "description": "Reduces resource consumption. Mass increases exponentially as efficiency improves.",
            "param": {
                "name": "Resource Mult",
                "type": "linear",
                "min": 0.1,
                "max": 1.0,
                "default": 1.0
            },
            "effects": [
                {
                    "stat": "consumption_mult",
                    "formula": "param"
                },
                {
                    "stat": "mass_mult",
                    "formula": "1.0 / param"
                },
                {
                    "stat": "cost_mult",
                    "formula": "1.0 / param"
                }
            ],
            "restrictions": {
                "allow_abilities": [
                    "ResourceConsumption"
                ]
