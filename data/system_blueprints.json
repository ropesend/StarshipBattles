            "description": "Barren system primarily used as transit point. Single star with minimal planetary bodies.",
            "weight": 15,
            "star_count": 1,
            "planet_count": {
                "min": 0,
                "max": 1
            },
            "star_mass": {
                "description": "Any mass range",
                "min": 0.1,
                "max": 10.0
            }
        },
        "gas_giant_system": {
            "description": "System dominated by gas giants and ice giants. Hot Jupiter and super-Jupiter systems.",
            "weight": 15,
            "star_count": 1,
            "planet_count": {
                "min": 2,
                "max": 5
            },
            "star_mass": {
                "description": "Larger stars more likely to form giants",
