{
    "version": "1.0",
    "description": "System blueprints for star system generation. Each blueprint defines a template for generating systems with specific characteristics.",
    "blueprints": {
        "binary_no_planets": {
            "description": "Binary star system with no or minimal planets. Common for close binaries where planetary formation is disrupted.",
            "weight": 10,
            "star_count": {
                "min": 2,
                "max": 2
            },
            "planet_count": {
                "min": 0,
                "max": 1
            },
            "star_mass": {
                "description": "Any mass range for binary stars",
                "min": 0.1,
                "max": 100.0
            }
        },
        "solar_like": {
            "description": "Solar system analog with single main sequence star and multiple planets. Most common template.",
            "weight": 50,
            "star_count": 1,
            "planet_count": {
                "min": 4,
                "max": 8
            },
            "star_mass": {
                "description": "G/K type star range",
                "min": 0.5,
                "max": 1.5
            },
            "planet_mass": {
                "description": "Normal distribution across all ranges",
                "distribution": "log_normal",
                "mu": 24.5,
                "sigma": 1.5
            }
        },
        "red_dwarf_pack": {
            "description": "Red dwarf with closely packed small planets. TRAPPIST-1 analog.",
            "weight": 25,
            "star_count": 1,
            "planet_count": {
                "min": 5,
                "max": 10
            },
            "star_mass": {
                "description": "Red dwarf mass range (0.08-0.5 solar masses)",
