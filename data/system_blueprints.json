                "max": 0.5
            },
            "planet_mass": {
                "description": "Bias towards smaller rocky planets",
                "bias": "small",
                "min": 1e21,
                "max": 5e25
            },
            "orbital_spacing": {
                "description": "Closer orbital spacing than normal",
                "factor": 0.6
            }
