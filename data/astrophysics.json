                "notes": "Frozen surface worlds"
            },
            "BARREN": {
                "pressure_max": 500,
                "temp_min": 200,
                "notes": "Airless rocky worlds"
            },
            "PELAGIC": {
                "water_min": 0.85,
                "notes": "Ocean worlds"
            },
            "ARID": {
                "water_max": 0.20,
                "temp_min": 255,
                "notes": "Desert worlds"
            },
            "CONTINENTAL": {
                "water_min": 0.10,
                "water_max": 0.85,
                "temp_min": 255,
                "temp_max": 350,
                "pressure_min": 5000,
                "notes": "Earth-like mixed terrain"
            }
        }
    },

    "density_models": {
