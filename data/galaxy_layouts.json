{
  "_comment": "Galaxy layout configurations for data-driven generation",
  "_version": "1.0.0",

  "layouts": {
    "cluster": {
      "name": "Globular Cluster",
      "description": "Dense central cluster with irregular edges",
      "primitives": [
        {
          "type": "radial",
          "center_q": 0,
          "center_r": 0,
          "sigma": 0.4,
          "peak_density": 1.0,
