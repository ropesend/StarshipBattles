          "peak_density": 1.0,
          "weight": 0.35,
          "_note": "Central bar, length/width relative to radius"
        },
        {
          "type": "spiral_arm",
          "center_q": 0,
          "center_r": 0,
          "arm_count": 2,
          "pitch_angle": 30,
