  "_scaling_notes": {
    "description": "Values like sigma, radius, width, length are relative to galaxy radius",
    "example": "sigma: 0.4 with galaxy_radius=1000 means sigma=400 hex units",
    "scaling_fields": ["sigma", "radius", "width", "length", "arm_width", "edge_falloff"],
    "position_fields": ["center_q", "center_r", "offset_q", "offset_r"]
  }
