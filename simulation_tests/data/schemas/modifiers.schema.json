{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://starship-battles/schemas/modifiers.json",
  "title": "Modifiers Schema v1.0",
  "description": "Schema for validating V2 modifier definitions in Combat Lab test data",
  "type": "object",
  "required": ["_metadata", "modifiers"],
  "properties": {
    "_metadata": {
      "type": "object",
      "required": ["_schema_version", "_data_version"],
      "properties": {
        "_schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$",
          "description": "Schema version (semver major.minor)"
        },
        "_data_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$",
          "description": "Data version (semver major.minor)"
        },
        "_last_modified": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of last modification"
        },
        "_description": {
          "type": "string",
          "description": "Optional description of this data file"
        }
      },
      "additionalProperties": false,
      "description": "Version metadata for schema/data compatibility tracking"
    },
    "modifiers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/modifier"
      },
      "description": "Array of V2 modifier definitions"
    }
  },
  "definitions": {
    "modifier": {
      "type": "object",
      "required": ["id", "effects"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_]+$",
          "description": "Unique modifier identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable modifier name"
        },
        "description": {
          "type": "string",
          "description": "Description of what this modifier does"
        },
        "param": {
          "$ref": "#/definitions/param",
          "description": "Parameter definition for adjustable modifiers"
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/effect"
          },
          "description": "Array of stat effects (V2 format)"
        },
        "restrictions": {
          "$ref": "#/definitions/restrictions",
          "description": "Component/ability restrictions"
        }
      },
      "additionalProperties": true
    },
    "param": {
      "type": "object",
      "required": ["name", "type", "min", "max", "default"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Display name for the parameter"
        },
        "type": {
          "type": "string",
          "enum": ["linear", "boolean"],
          "description": "Parameter type"
        },
        "min": {
          "type": "number",
          "description": "Minimum parameter value"
        },
        "max": {
          "type": "number",
          "description": "Maximum parameter value"
        },
        "default": {
          "type": "number",
          "description": "Default parameter value"
        }
      },
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "required": ["stat", "formula"],
      "properties": {
        "stat": {
          "type": "string",
          "description": "Stat key to modify"
        },
        "formula": {
          "type": "string",
          "description": "Formula expression using 'param' variable"
        },
        "operation": {
          "type": "string",
          "enum": ["multiply", "add", "set", "add_to_mult"],
          "description": "How the computed value is applied (default: multiply)"
        },
        "target_ability": {
          "type": "string",
          "description": "Target specific ability class name"
        },
        "depends_on": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Stat keys this formula depends on"
        }
      },
      "additionalProperties": false
    },
    "restrictions": {
      "type": "object",
      "properties": {
        "allow_abilities": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Ability class names that must be present"
        },
        "deny_abilities": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Ability class names that must NOT be present"
        },
        "require_mode": {
          "type": "string",
          "enum": ["any", "all"],
          "description": "Match mode for allow_abilities (default: any)"
        }
      },
      "additionalProperties": false
    }
  }
}
